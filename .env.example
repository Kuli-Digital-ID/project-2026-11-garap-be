# Application
NODE_ENV=development
PORT=4000
APP_NAME=project-2026-11-garap-be

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/garap_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# CORS: alamat FE. Beberapa alamat dipisah koma, mis. http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Alamat FE (tujuan redirect setelah menghubungkan akun sosmed)
FRONTEND_URL=http://localhost:3000

# Login email + password
# Salah password berturut-turut sebelum akun dikunci, dan lama kuncinya (menit)
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
# Cookie sesi. lax: FE & API satu situs (localhost, atau app.domain.id + api.domain.id).
# none: FE & API beda situs (mis. *.workers.dev + domain lain) — wajib HTTPS.
COOKIE_SAMESITE=lax
# Mis. .kulidigital.id agar cookie berlaku di subdomain FE & API. Kosongkan di lokal.
COOKIE_DOMAIN=

# Batas request per IP per menit (semua endpoint / login & ganti password)
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Isi 1 bila API di belakang satu reverse proxy (nginx, Nginx Proxy Manager, Cloudflare Tunnel) agar IP asli terbaca
TRUST_PROXY=false

# Lampiran yang diunggah
# STORAGE_DRIVER=local → disimpan di UPLOAD_DIR; s3 → bucket Cloudflare R2 / S3 / MinIO (isi S3_* di bawah)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=25
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
# Buat API token R2 dengan izin "Object Read & Write" untuk bucket ini. Bucket tidak perlu akses publik.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Folder induk opsional di dalam bucket, mis. garap/ (kosong = langsung proyek/… dan permintaan/…)
S3_PREFIX=

# Kunci enkripsi API key penyedia AI (min. 16 karakter, buat sekali: openssl rand -base64 32)
AI_KEY_SECRET=ganti-dengan-string-acak-panjang

# Alamat publik API, dipakai untuk URL unduh lampiran & callback OAuth sosmed
API_PUBLIC_URL=http://localhost:4000
# Pekerja latar konten (konten rutin, tayang terjadwal, statistik)
CONTENT_RUNNER=true

# Aplikasi developer sosmed. Callback: {API_PUBLIC_URL}/api/v1/social/oauth/callback/{platform}
# Kosongkan bila belum ada; akun platform itu tetap bisa dipakai mode manual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_PRIVACY=public
TIKTOK_PRIVACY=SELF_ONLY

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
