# Application
NODE_ENV=development
PORT=4000
APP_NAME=project-2026-11-garap-be

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/garap_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend Garap (redirect setelah login SSO)
FRONTEND_URL=http://localhost:3000

# Login email + password: hanya untuk pengembangan lokal (produksi pakai SSO)
AUTH_PASSWORD_LOGIN=true

# SSO Keycloak (OIDC, client confidential "garap-web")
KEYCLOAK_ISSUER=https://sso.kulidigital.id/realms/kulidigital
KEYCLOAK_CLIENT_ID=garap-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/callback

# Kunci enkripsi API key penyedia AI (min. 16 karakter, buat sekali: openssl rand -base64 32)
AI_KEY_SECRET=ganti-dengan-string-acak-panjang

# Alamat publik API, dipakai untuk callback OAuth sosmed
API_PUBLIC_URL=http://localhost:4000
# Pekerja latar konten (konten rutin, tayang terjadwal, statistik)
CONTENT_RUNNER=true

# Aplikasi developer sosmed. Callback: {API_PUBLIC_URL}/api/v1/social/oauth/callback/{platform}
# Kosongkan bila belum ada; akun platform itu tetap bisa dipakai mode manual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_PRIVACY=public
TIKTOK_PRIVACY=SELF_ONLY

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
