# Isi lalu tempel SELURUH isinya ke GitHub secret ENV_FILE (Settings › Secrets and variables › Actions).
# Workflow deploy menulisnya ke /home/dev/backend/garap-be/.env di server. Jangan commit file berisi nilai asli.
NODE_ENV=production
PORT=3001
APP_NAME=garap-api

# Postgres yang sudah ada di server. Container memakai --network=host, jadi cukup 127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/garap_db?schema=public

# Buat masing-masing dengan: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
AI_KEY_SECRET=
JWT_EXPIRATION=7d

# Alamat publik: API di garap.kulidigital.cloud, FE di garap.kulidigital.id
API_PUBLIC_URL=https://garap.kulidigital.cloud
FRONTEND_URL=https://garap.kulidigital.id
CORS_ORIGIN=https://garap.kulidigital.id

# Cookie sesi. FE (.id) dan API (.cloud) beda situs → cookie lintas situs: wajib none + HTTPS, domain dikosongkan.
# Catatan: Safari & Firefox memblokir cookie lintas situs. Lihat README "Domain FE & API".
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# API di belakang satu reverse proxy (Nginx Proxy Manager: garap.kulidigital.cloud → http://127.0.0.1:3001)
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Lampiran di Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=garap
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
UPLOAD_MAX_MB=25

# Pekerja konten (konten rutin, publikasi terjadwal)
CONTENT_RUNNER=true

# Swagger mati di produksi; set true sementara bila perlu
SWAGGER_ENABLED=false
